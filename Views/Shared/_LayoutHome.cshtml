<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - EcoDrive</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Poppins:wght@600;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
</head>
<body>
    <header class="home-topo">
        <div class="home-largura">
            <a href="~/"><img class="logo" src="~/img/logo.png" alt="eco drive" /></a>
            <nav>
                <a class="link-entrar" asp-controller="Home" asp-action="Login">Entrar</a>
                <a class="btn-lima" asp-controller="Home" asp-action="Cadastrar">Criar conta</a>
            </nav>
        </div>
    </header>

    @RenderBody()

    <footer class="home-rodape">
        <a asp-area="Colaborador" asp-controller="Home" asp-action="Login">Sou colaborador</a>
    </footer>
</body>
</html>