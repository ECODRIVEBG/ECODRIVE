<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - EcoDrive</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/ecodrive.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="topbar-logo" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/img/logo.png" alt="eco drive" /></a>
        <div class="user-info">
            <a class="link-topo" asp-area="" asp-controller="Home" asp-action="Index">Voltar &rarr;</a>
        </div>
    </header>
    <main class="auth-pagina">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/mask/jquery.mask.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>