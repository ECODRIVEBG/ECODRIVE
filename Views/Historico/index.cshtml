@model List<EcoDriveTcc.Models.HistoricoLocacao>
@{
    Layout = "_LayoutCliente";
    ViewData["Title"] = "Histórico";
    ViewData["Aba"] = "Historico";
}
<h2 class="hist-titulo">Histórico de locações</h2>

@if (Model.Count == 0)
{
    <p class="vazio">Você ainda não fez nenhuma locação.</p>
}

@foreach (var corrida in Model)
{
    string destino = "Em andamento";
    if (corrida.Problema)
    {
        destino = "Problema reportado";
    }
    else if (corrida.NomePontoFim != null)
    {
        destino = corrida.NomePontoFim;
    }
    string horaFim = "";
    if (corrida.FimCorrida.HasValue)
    {
        horaFim = corrida.FimCorrida.Value.ToString("HH:mm");
    }
    <div class="hist-item">
        <div class="hist-info">
            <strong>@corrida.TipoVeiculo @corrida.TokenVeiculo</strong>
            <span>@corrida.NomePontoInicio &rarr; @destino</span>
            <span>@corrida.InicioCorrida.ToString("dd/MM/yy") &bull; @corrida.InicioCorrida.ToString("HH:mm") ~ @horaFim</span>
        </div>
        @if (corrida.ValorCorrida.HasValue)
        {
            <div class="hist-valor">
                R$ @corrida.ValorCorrida.Value
                @if (corrida.Problema)
                {
                    <small>Sem cobrança</small>
                }
            </div>
        }
    </div>
}