@model EcoDriveTcc.Models.Cliente
@{
    Layout = "_LayoutCliente";
    ViewData["Title"] = "Saldo";
    ViewData["Aba"] = "Saldo";
}
<form method="post" asp-controller="Home" asp-action="Recarregar">
    <div class="saldo-grid">
        <div>
            <div class="saldo-card">
                <span>Saldo disponível</span>
                <strong>R$ @Model.Saldo</strong>
            </div>

            <div class="card recarga-card">
                <h4>Recarregar saldo</h4>
                <div class="recarga-linha">
                    <input type="text" name="valor" inputmode="decimal" placeholder="R$ 0,00" autocomplete="off" required />
                    <button type="submit">+ Recarregar</button>
                </div>
                <p class="nota">Saldo gerenciado internamente — sem integração com meios de pagamento externos.</p>
            </div>
        </div>

        <div>
            <div class="card pagto-card">
                <div class="pagto-topo">
                    Confirmar pagamento
                    <img src="~/img/logo.png" alt="eco drive" />
                </div>
                <div class="pagto-corpo">
                    <h5>Método de pagamento</h5>
                    <label class="metodo">Cartão de Débito <input type="radio" name="metodo" value="Debito" required /></label>
                    <label class="metodo">Cartão de Crédito <input type="radio" name="metodo" value="Credito" /></label>
                    <label class="metodo">Pix <input type="radio" name="metodo" value="Pix" /></label>
                </div>
            </div>

            <div class="pix-qr">
                <img src="~/img/qrcode-pix.png" alt="QR Code do Pix" />
                <p>Escaneie o QR Code para pagar com Pix</p>
            </div>
        </div>
    </div>
</form>