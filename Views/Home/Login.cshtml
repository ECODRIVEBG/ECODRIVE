@model EcoDriveTcc.Models.Cliente
@{
    ViewData["Title"] = "Entrar";
    Layout = "_LayoutClienteSemMenu";
}
<div class="auth-card">
    <div class="auth-abas">
        <a asp-action="Login" class="active">Entrar</a>
        <a asp-action="Cadastrar">Cadastrar</a>
    </div>

    @if (TempData["MSG_S"] != null)
    {
        <p class="alert alert-success">@TempData["MSG_S"]</p>
    }
    @if (ViewData["MSG_E"] != null)
    {
        <p class="alert alert-danger">@ViewData["MSG_E"]</p>
    }

    <form method="post" asp-action="Login">
        <div class="form-group">
            <label asp-for="Email">E-mail</label>
            <input asp-for="Email" type="email" placeholder="seu@email.com" />
        </div>
        <div class="form-group">
            <label asp-for="Senha">Senha</label>
            <input asp-for="Senha" type="password" placeholder="Sua senha" />
        </div>
        <button type="submit" class="btn-enviar">Entrar</button>
    </form>
</div>