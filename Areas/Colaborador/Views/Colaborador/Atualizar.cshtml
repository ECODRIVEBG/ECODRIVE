@model EcoDriveTcc.Models.Funcionario
@{
    ViewData["Title"] = "Atualizar funcionário";
}
<h1>Atualizar funcionário</h1>

<div class="card">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <form method="post" asp-action="Atualizar">
        <input type="hidden" asp-for="IdFuncionario" />
        <div class="form-group">
            <label asp-for="Nome">Nome</label>
            <input asp-for="Nome" required />
        </div>
        <div class="form-group">
            <label asp-for="Email">E-mail</label>
            <input asp-for="Email" required />
        </div>
        <div class="form-group">
            <label asp-for="CPF">CPF</label>
            <input asp-for="CPF" maxlength="11" required />
        </div>
        <div class="form-group">
            <label asp-for="Cargo">Cargo</label>
            <input asp-for="Cargo" required />
        </div>
        <div class="form-group">
            <label asp-for="Telefone">Telefone</label>
            <input asp-for="Telefone" />
        </div>
        <div class="form-group">
            <label asp-for="NivelAcesso">Nível de acesso</label>
            <select asp-for="NivelAcesso">
                <option value="Funcionario">Funcionário</option>
                <option value="Admin">Admin</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-outline-dark">Voltar</a>
    </form>
</div>