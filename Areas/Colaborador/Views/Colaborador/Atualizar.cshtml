@model EcoDriveTcc.Models.Funcionario
@{
    ViewData["Title"] = "Atualizar funcionário";
}
<h1>Atualizar funcionário</h1>

<div class="card">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <form method="post" asp-action="Atualizar">
        <input type="hidden" asp-for="IdFuncionario" />
        <div class="form-group">
            <label asp-for="Nome">Nome</label>
            <input asp-for="Nome" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Email">E-mail</label>
            <input asp-for="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="CPF">CPF</label>
            <input asp-for="CPF" class="CPF" placeholder="000.000.000-00" />
            <span asp-validation-for="CPF" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Cargo">Cargo</label>
            <input asp-for="Cargo" />
            <span asp-validation-for="Cargo" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Telefone">Telefone</label>
            <input asp-for="Telefone" class="Telefone" placeholder="(00) 00000-0000" />
            <span asp-validation-for="Telefone" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="NivelAcesso">Nível de acesso</label>
            <select asp-for="NivelAcesso">
                <option value="Funcionario">Funcionário</option>
                <option value="Admin">Admin</option>
            </select>
            <span asp-validation-for="NivelAcesso" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Senha">Senha</label>
            <input asp-for="Senha" type="password" value="@Model.Senha" />
            <span asp-validation-for="Senha" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-outline-dark">Voltar</a>
    </form>
</div>