@model IEnumerable<EcoDriveTcc.Models.Funcionario>
@{
    ViewData["Title"] = "Funcionários";
}
<h1>Funcionários</h1>

@if (TempData["MSG_S"] != null)
{
    <p class="alert alert-success">@TempData["MSG_S"]</p>
}
@if (TempData["MSG_E"] != null)
{
    <p class="alert alert-danger">@TempData["MSG_E"]</p>
}

<p><a asp-action="Cadastrar" class="btn btn-primary">Cadastrar</a></p>

<div class="card">
    <table>
        <thead>
            <tr>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Cargo</th>
                <th>Nível</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var funcionario in Model)
            {
                <tr>
                    <td>@funcionario.Nome</td>
                    <td>@funcionario.Email</td>
                    <td>@funcionario.Cargo</td>
                    <td>@funcionario.NivelAcesso</td>
                    <td>
                        <a asp-action="Atualizar" asp-route-id="@funcionario.IdFuncionario" class="btn btn-outline-dark">Atualizar</a>
                        @Html.ActionLink("Excluir", "Excluir", new { id = funcionario.IdFuncionario },
                            new { @class = "btn btn-danger", onclick = "return confirm('Deseja realmente excluir?');" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>