<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - EcoDrive</title>
    <link rel="stylesheet" href="~/css/ecodrive.css" />
</head>
<body>
    <header class="topbar">
        <a asp-controller="Home" asp-action="Index" asp-area="" style="color:#fff;">Voltar</a>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/mask/jquery.mask.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    @RenderSection("Scripts", required: false)
</body>
</html>