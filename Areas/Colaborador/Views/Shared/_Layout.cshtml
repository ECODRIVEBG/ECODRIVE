@using EcoDriveTcc.Models.Constants
@{
    bool logado = ViewBag.Nome != null;
    bool ehAdmin = logado && ViewBag.NivelAcesso == NivelAcessoConstant.Admin;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - EcoDrive</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/ecodrive.css" asp-append-version="true" />
</head>
<body>
    @if (logado)
    {
        <header class="topbar">
            <a class="topbar-logo" asp-area="Colaborador" asp-controller="Monitoramento" asp-action="Index"><img src="~/img/logo.png" alt="eco drive" /></a>
            <div class="user-info">
                <span class="papel-pill">@(ehAdmin ? "Administrador" : "Funcionário")</span>
                <span>@ViewBag.Nome</span>
                <a class="link-topo" asp-area="Colaborador" asp-controller="Cliente" asp-action="Index">Clientes</a>
                @if (ehAdmin)
                {
                    <a class="link-topo" asp-area="Colaborador" asp-controller="Colaborador" asp-action="Index">Funcionários</a>
                }
                <a class="link-topo" asp-area="Colaborador" asp-controller="Home" asp-action="Logout">Sair</a>
            </div>
        </header>
    }
    <main class="container">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/mask/jquery.mask.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>