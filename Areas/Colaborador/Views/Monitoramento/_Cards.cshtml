@using EcoDriveTcc.Models.Constants
@{
    bool ehAdmin = ViewBag.NivelAcesso == NivelAcessoConstant.Admin;
}
<div class="dashboard-cards">
    <div class="card">
        <div class="icone-cartao" style="color:#16a34a;background:#e3f8ea;"><svg viewBox="0 0 24 24"><path d="M9 11l3 3 8-8" /><path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h9" /></svg></div>
        <div class="numero" style="color:#16a34a;">@ViewBag.Disponiveis</div>
        Disponíveis
    </div>
    <div class="card">
        <div class="icone-cartao" style="color:#2563eb;background:#e6eefc;"><svg viewBox="0 0 24 24"><circle cx="6" cy="17" r="3" /><circle cx="18" cy="17" r="3" /><path d="M6 17l4-8h5l3 8M10 9 8.5 6H6" /></svg></div>
        <div class="numero" style="color:#2563eb;">@ViewBag.EmUso</div>
        Em uso
    </div>
    <div class="card">
        <div class="icone-cartao" style="color:#ea580c;background:#fdeee3;"><svg viewBox="0 0 24 24"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z" /></svg></div>
        <div class="numero" style="color:#ea580c;">@ViewBag.EmManutencao</div>
        Manutenção
    </div>
    <div class="card">
        <div class="icone-cartao" style="color:#d4161c;background:#fde7e7;"><svg viewBox="0 0 24 24"><rect x="2" y="7" width="17" height="10" rx="2" /><path d="M22 11v2" /><path d="M6 10v4" /></svg></div>
        <div class="numero" style="color:#d4161c;">@ViewBag.BateriaBaixa</div>
        Bateria baixa
    </div>
</div>
<div class="tabs">
    <a asp-action="Index" asp-route-aba="Bike" class="@(ViewBag.Aba == "Bike" ? "active" : "")">Bike Urbana</a>
    <a asp-action="Index" asp-route-aba="Patinete" class="@(ViewBag.Aba == "Patinete" ? "active" : "")">Patinete Elétrico</a>
    <a asp-action="Index" asp-route-aba="Manutencao" class="@(ViewBag.Aba == "Manutencao" ? "active" : "")">Manutenção</a>
    @if (ehAdmin)
    {
        <a asp-action="Index" asp-route-aba="CadastroAtivos" class="@(ViewBag.Aba == "CadastroAtivos" ? "active" : "")">Cadastro de ativos</a>
    }
</div>