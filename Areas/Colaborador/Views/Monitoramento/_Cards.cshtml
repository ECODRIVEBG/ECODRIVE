@using EcoDriveTcc.Models.Constants
@{
    bool ehAdmin = ViewBag.NivelAcesso == NivelAcessoConstant.Admin;
}
<div class="dashboard-cards">
    <div class="card">
        <div class="numero" style="color:#16a34a;">@ViewBag.Disponiveis</div>
        Disponíveis
    </div>
    <div class="card">
        <div class="numero" style="color:#2563eb;">@ViewBag.EmUso</div>
        Em uso
    </div>
    <div class="card">
        <div class="numero" style="color:#ea580c;">@ViewBag.EmManutencao</div>
        Manutenção
    </div>
    <div class="card">
        <div class="numero" style="color:#d4161c;">@ViewBag.BateriaBaixa</div>
        Bateria baixa
    </div>
</div>
<div class="tabs">
    <a asp-action="Index" asp-route-aba="Bike" class="@(ViewBag.Aba == "Bike" ? "active" : "")">Bike Urbana</a>
    <a asp-action="Index" asp-route-aba="Patinete" class="@(ViewBag.Aba == "Patinete" ? "active" : "")">Patinete Elétrico</a>
    <a asp-action="Index" asp-route-aba="Manutencao" class="@(ViewBag.Aba == "Manutencao" ? "active" : "")">Manutenção</a>
    @if (ehAdmin)
    {
        <a asp-action="Index" asp-route-aba="CadastroAtivos" class="@(ViewBag.Aba == "CadastroAtivos" ? "active" : "")">Cadastro de ativos</a>
    }
</div>