@{
    ViewData["Title"] = "Cadastro de ativos";
    var pontos = (List<Ponto>)ViewBag.Pontos;
}
<h1>Monitoramento</h1>

@if (TempData["MSG_S"] != null)
{
    <p class="alert alert-success">@TempData["MSG_S"]</p>
}
@if (TempData["MSG_E"] != null)
{
    <p class="alert alert-danger">@TempData["MSG_E"]</p>
}

@await Html.PartialAsync("_Cards")

<div class="card">
    <h4>Adicionar um novo ativo</h4>
    <form method="post" asp-action="CadastrarAtivo">
        <div class="form-group">
            <label>Tipo</label>
            <select name="tipo" required>
                <option value="Bike">Bike</option>
                <option value="Patinete">Patinete</option>
            </select>
        </div>
        <div class="form-group">
            <label>Token</label>
            <input type="text" name="token" placeholder="0000-X" required />
        </div>
        <div class="form-group">
            <label>Ponto P</label>
            <select name="idPonto" required>
                @foreach (var ponto in pontos)
                {
                    <option value="@ponto.IdPonto">@ponto.Nome - @ponto.Bairro</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Cadastrar</button>
    </form>
</div>