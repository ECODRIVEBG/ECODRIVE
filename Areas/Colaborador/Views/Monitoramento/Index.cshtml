@model IEnumerable<EcoDriveTcc.Models.Veiculo>
@using EcoDriveTcc.Models.Constants
@{
    ViewData["Title"] = "Monitoramento";
    bool ehAdmin = ViewBag.NivelAcesso == NivelAcessoConstant.Admin;
}
<h1>Monitoramento</h1>

@if (TempData["MSG_S"] != null)
{
    <p class="alert alert-success">@TempData["MSG_S"]</p>
}
@if (TempData["MSG_E"] != null)
{
    <p class="alert alert-danger">@TempData["MSG_E"]</p>
}

@await Html.PartialAsync("_Cards")

<div class="card tabela-card">
    <table>
        <thead>
            <tr>
                <th>Token</th>
                <th>Tipo</th>
                <th>Status</th>
                @if (ViewBag.Aba == "Patinete")
                {
                    <th>Bateria</th>
                }
                <th>Ponto P</th>
                @if (ehAdmin)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var veiculo in Model)
            {
                string nomeStatus = veiculo.Status_ == StatusVeiculoConstant.EmUso ? "Em uso"
                    : veiculo.Status_ == StatusVeiculoConstant.Manutencao ? "Manutenção" : "Disponível";
                string classeBateria = !veiculo.NivelBateria.HasValue ? ""
                    : veiculo.NivelBateria.Value < BateriaConstant.LimiteBaixa ? "bat-baixa"
                    : veiculo.NivelBateria.Value < 50 ? "bat-media" : "bat-alta";
                <tr>
                    <td class="token">@veiculo.Chave</td>
                    <td>
                        <span class="tipo">
                            @if (veiculo.Tipo == TipoVeiculoConstant.Patinete)
                            {
                                <svg viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7z" /></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24"><circle cx="6" cy="17" r="3" /><circle cx="18" cy="17" r="3" /><path d="M6 17l4-8h5l3 8M10 9 8.5 6H6" /></svg>
                            }
                            @veiculo.Tipo
                        </span>
                    </td>
                    <td><span class="pill pill-@veiculo.Status_.ToLower()">@nomeStatus</span></td>
                    @if (ViewBag.Aba == "Patinete")
                    {
                        <td class="@classeBateria">@(veiculo.NivelBateria.HasValue ? veiculo.NivelBateria + "%" : "-")</td>
                    }
                    <td>@veiculo.NomePonto</td>
                    @if (ehAdmin)
                    {
                        <td>
                            <form method="post" asp-action="ExcluirAtivo">
                                <input type="hidden" name="idVeiculo" value="@veiculo.IdVeiculo" />
                                <input type="hidden" name="aba" value="@ViewBag.Aba" />
                                <button type="submit" class="icone-excluir" title="Excluir">
                                    <svg viewBox="0 0 24 24"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" /><path d="M10 11v6M14 11v6" /></svg>
                                </button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>