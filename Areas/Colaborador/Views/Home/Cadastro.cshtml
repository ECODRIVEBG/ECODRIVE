@model EcoDriveTcc.Models.Funcionario
@{
    ViewData["Title"] = "Cadastrar";
    Layout = "_LayoutSemMenu";
}
<div class="card" style="max-width:420px;margin:60px auto;">
    <h3>Criar conta</h3>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <form method="post" asp-action="Cadastro">
        <div class="form-group">
            <label asp-for="Nome">Nome</label>
            <input asp-for="Nome" required />
        </div>
        <div class="form-group">
            <label asp-for="Email">E-mail</label>
            <input asp-for="Email" type="email" required />
        </div>
        <div class="form-group">
            <label asp-for="CPF">CPF</label>
            <input asp-for="CPF" maxlength="11" required />
        </div>
        <div class="form-group">
            <label asp-for="Cargo">Cargo</label>
            <input asp-for="Cargo" required />
        </div>
        <div class="form-group">
            <label asp-for="Telefone">Telefone</label>
            <input asp-for="Telefone" />
        </div>
        <div class="form-group">
            <label asp-for="Senha">Senha</label>
            <input asp-for="Senha" type="password" required />
        </div>
        <button type="submit" class="btn btn-dark" style="width:100%;">Criar conta</button>
    </form>
    <p style="text-align:center;margin-top:16px;">
        Já tem conta? <a asp-action="Login">Entrar</a>
    </p>
</div>