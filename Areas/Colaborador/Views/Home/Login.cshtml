@model EcoDriveTcc.Models.Funcionario
@{
    ViewData["Title"] = "Entrar";
    Layout = "_LayoutSemMenu";
}
<div class="card" style="max-width:420px;margin:60px auto;">
    <h3>Área do colaborador</h3>

    @if (TempData["MSG_S"] != null)
    {
        <p class="alert alert-success">@TempData["MSG_S"]</p>
    }
    @if (ViewData["MSG_E"] != null)
    {
        <p class="alert alert-danger">@ViewData["MSG_E"]</p>
    }

    <form method="post" asp-action="Login">
        <div class="form-group">
            <label asp-for="Email">E-mail</label>
            <input asp-for="Email" placeholder="seu@email.com" />
        </div>
        <div class="form-group">
            <label asp-for="Senha">Senha</label>
            <input asp-for="Senha" type="password" placeholder="Sua senha" />
        </div>
        <button type="submit" class="btn btn-dark" style="width:100%;">Entrar</button>
    </form>
    <p style="text-align:center;margin-top:16px;">
        Ainda não tem conta? <a asp-action="Cadastro">Cadastrar</a>
    </p>
</div>